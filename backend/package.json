{
  "name": "maintenance-system-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "npm run build && node dist/core/database/seeds/seed.js",
    "seed:dev": "npm run build && node dist/core/database/seeds/dev.seed.js",
    "test": "jest --runInBand",
    "migration:generate": "npm run build && typeorm migration:generate src/core/database/migrations/InitialSchema -d dist/core/database/data-source.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/core/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/core/database/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/core/database/data-source.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
